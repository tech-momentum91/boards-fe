# Boards local site (Frappe site name: boards.local)
# Frontend: http://localhost:5164  (or http://boards.local:5164)
# Backend:  http://localhost:4000  (default site = boards.local)

VITE_API_URL=http://localhost:4000
VITE_SITE_NAME=boards.local

# Frappe socketio port (see sites/common_site_config.json → socketio_port)
# Must match VITE_SITE_NAME — wrong site name breaks realtime (unread badge / inbox live updates).
VITE_SOCKET_PORT=9000
VITE_SOCKET_URL=http://localhost:9000
